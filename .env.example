# Copy to .env. Never commit .env or real API keys.
PORT=8787
HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BROWSER_USE_API_KEY=
# Optional exact origins allowed to call the backend, comma separated.
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Optional domain allowlist for browser automation, comma separated. Empty means public hosts allowed except private/local addresses.
BROWSER_ALLOWED_HOSTS=
